<Window x:Class="LTEFCCTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="680" Width="1060"
        MinHeight="560" MinWidth="900"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ─── Colours ─────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgDeep"     Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BgPanel"    Color="#252526"/>
        <SolidColorBrush x:Key="BgCard"     Color="#2D2D30"/>
        <SolidColorBrush x:Key="BgInput"    Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Accent"     Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHov"  Color="#1A8FDB"/>
        <SolidColorBrush x:Key="FgPrim"     Color="#D4D4D4"/>
        <SolidColorBrush x:Key="FgSec"      Color="#858585"/>
        <SolidColorBrush x:Key="FgPass"     Color="#4EC94E"/>
        <SolidColorBrush x:Key="FgFail"     Color="#F44747"/>
        <SolidColorBrush x:Key="FgWarn"     Color="#DCDCAA"/>
        <SolidColorBrush x:Key="Border"     Color="#3F3F46"/>
        <SolidColorBrush x:Key="BtnGreen"   Color="#198754"/>
        <SolidColorBrush x:Key="BtnGreenH"  Color="#146C43"/>
        <SolidColorBrush x:Key="BtnRed"     Color="#DC3545"/>
        <SolidColorBrush x:Key="BtnRedH"    Color="#B02A37"/>

        <!-- ─── TextBlock ────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <!-- ─── Label ───────────────────────────────────────────── -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource FgSec}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="0,0,4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ─── TextBox ──────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"       Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"       Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="5,3"/>
            <Setter Property="FontFamily"       Value="Consolas"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="{StaticResource FgPrim}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ─── ComboBox ─────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground"      Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="4"
                                    Background="#1E2A35" BorderThickness="1"
                                    BorderBrush="#007ACC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                        Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="#E8E8E8" FontSize="12"
                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        IsHitTestVisible="False"/>
                                    <Border Grid.Column="1" CornerRadius="0,4,4,0"
                                            Background="#007ACC">
                                        <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                              Fill="White" Width="12" Height="6"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ToggleButton Grid.ColumnSpan="2"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" PopupAnimation="Fade">
                                <Border CornerRadius="0,0,4,4" BorderBrush="#007ACC" BorderThickness="1"
                                        Background="#1E2A35" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00BFFF"/>
                                <Setter TargetName="bd" Property="Background" Value="#243242"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00BFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Foreground="#E8E8E8" FontSize="12" Padding="0,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#005A9E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Generic Button ───────────────────────────────────── -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>
        <Style x:Key="BtnGo" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BtnGreen}"/>
        </Style>
        <Style x:Key="BtnStop" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BtnRed}"/>
        </Style>

        <!-- ─── CheckBox ─────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrim}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ─── Separator ────────────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource Border}"/>
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>

        <!-- ─── ScrollBar ────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Border CornerRadius="3" Background="#2A2A2A" Margin="1,4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBd" CornerRadius="3"
                                                        Background="#555555" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="#888888"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── DataGrid ─────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"            Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"            Value="{StaticResource FgPrim}"/>
            <Setter Property="BorderBrush"           Value="{StaticResource Border}"/>
            <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3A3A3A"/>
            <Setter Property="RowBackground"         Value="{StaticResource BgCard}"/>
            <Setter Property="AlternatingRowBackground" Value="#282828"/>
            <Setter Property="FontFamily"            Value="Consolas"/>
            <Setter Property="FontSize"              Value="12"/>
            <Setter Property="ColumnHeaderHeight"    Value="28"/>
            <Setter Property="RowHeight"             Value="24"/>
            <Setter Property="SelectionMode"         Value="Single"/>
            <Setter Property="AutoGenerateColumns"   Value="False"/>
            <Setter Property="CanUserAddRows"        Value="False"/>
            <Setter Property="CanUserDeleteRows"     Value="False"/>
            <Setter Property="CanUserResizeRows"     Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="#1A1A1A"/>
            <Setter Property="Foreground"  Value="#AAAAAA"/>
            <Setter Property="FontFamily"  Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#37373D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Header bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="22"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════  HEADER  ═════════════════════════ -->
        <Border Grid.Row="0" Background="#11111B">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LTEFCCTesterV1.0"
                               FontFamily="Segoe UI Semibold" FontSize="16"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <TextBlock Text=" Band 26 | 传导功率"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="{StaticResource FgSec}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <!-- Status indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnLed" Width="10" Height="10"
                             Fill="#F44747" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ConnLabel" Text="Disconnected"
                               Foreground="{StaticResource FgSec}" FontSize="11"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════  MAIN  ════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT PANEL ──────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,8,8,8">

                        <!-- Connection -->
                        <TextBlock Text="连接 CONNECTION" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Margin="0,0,0,6"/>
                        <Label Content="IP 地址"/>
                        <ComboBox x:Name="CbIpAddress" Height="28" Margin="0,2,0,8"
                                  IsEditable="False" SelectedIndex="1"/>

                        <Separator Margin="0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnConnect" Content="Connect"
                                    Style="{StaticResource BtnAccent}"
                                    Click="BtnConnect_Click" Margin="0,0,3,0"/>
                            <Button x:Name="BtnDisconnect" Content="Disconnect"
                                    Grid.Column="1" Style="{StaticResource BtnBase}"
                                    Background="#555" IsEnabled="False"
                                    Click="BtnDisconnect_Click" Margin="3,0,0,0"/>
                        </Grid>

                        <Separator Margin="0,8"/>

                        <!-- Test Setup -->
                        <TextBlock Text="测试设置 TEST SETUP" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Margin="0,0,0,6"/>

                        <!-- Bandwidth selection (checkboxes, default all checked) -->
                        <TextBlock Text="带宽 (Bandwidth)" Foreground="{StaticResource FgSec}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="0,0,0,4"/>
                        <WrapPanel x:Name="BwPanel" Margin="2,2,0,6"/>

                        <Separator Margin="0,4"/>

                        <!-- CMW500 Cable Loss Table -->
                        <CheckBox x:Name="ChkCmwLoss"
                                  Content="CMW500 线损表"
                                  FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                  Foreground="{StaticResource FgPrim}"
                                  Margin="0,4,0,6" IsChecked="True"
                                  Checked="ChkCmwLoss_Changed" Unchecked="ChkCmwLoss_Changed"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnExportLossTemplate"
                                    Style="{StaticResource BtnBase}"
                                    Background="#444"
                                    Height="26" FontSize="11"
                                    Click="BtnExportLossTemplate_Click"
                                    Margin="0,0,3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="导出模板" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnImportLoss" Grid.Column="1"
                                    Style="{StaticResource BtnBase}"
                                    Background="#444"
                                    Height="26" FontSize="11"
                                    Click="BtnImportLoss_Click"
                                    Margin="3,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📤" FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="导入线损" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="TxbCmwLossStatus"
                                   Text="不设置线损表"
                                   Foreground="{StaticResource FgSec}"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Margin="2,0,0,4"/>

                        <Separator Margin="0,8"/>

                        <!-- Action Buttons -->
                        <TextBlock Text="测试控制 TEST CONTROL" Foreground="{StaticResource Accent}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Margin="0,0,0,6"/>
                        <Button x:Name="BtnStartTest" Content="▶  开始测试 Start"
                                Style="{StaticResource BtnGo}" Height="34"
                                FontSize="13" IsEnabled="False"
                                Click="BtnStartTest_Click" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnStopTest" Content="■  停止"
                                    Style="{StaticResource BtnStop}" Height="30"
                                    FontSize="12" IsEnabled="False"
                                    Click="BtnStopTest_Click" Margin="0,0,3,0"/>
                            <Button x:Name="BtnPause" Grid.Column="1" Content="⏸  暂停"
                                    Style="{StaticResource BtnBase}" Background="#775500"
                                    Height="30" FontSize="12" IsEnabled="False"
                                    Click="BtnPause_Click" Margin="3,0,0,0"/>
                        </Grid>
                        <Button x:Name="BtnExport" Content="📄  导出 Excel"
                                Style="{StaticResource BtnAccent}" Height="28"
                                IsEnabled="False"
                                Click="BtnExport_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnClearLog" Content="🗑  清空日志"
                                Style="{StaticResource BtnBase}" Background="#444"
                                Height="24" FontSize="11"
                                Click="BtnClearLog_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── LEFT/RIGHT gap (fixed width, no resize) ─────────── -->

            <!-- ─── RIGHT PANEL ─────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="160" MinHeight="60"/>
                </Grid.RowDefinitions>

                <!-- Test Plan Table -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header bar -->
                        <Border Grid.Row="0" Background="#1A1A2E" Padding="10,6"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="测试计划 TEST PLAN"
                                               FontFamily="Segoe UI Semibold" FontSize="11"
                                               Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxbResultSummary"
                                               Text=""
                                               Foreground="{StaticResource FgSec}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <!-- Progress bar -->
                                <ProgressBar x:Name="ProgBar" HorizontalAlignment="Right"
                                             Width="180" Height="14" Minimum="0" Maximum="100"
                                             Value="0" Foreground="{StaticResource Accent}"
                                             Background="{StaticResource BgCard}"
                                             BorderBrush="{StaticResource Border}"
                                             VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid x:Name="DgResults" Grid.Row="1"
                                  BorderThickness="0" IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsChecked="True"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="全选 / 全不选"
                                                  Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="信道"    Width="56"
                                    Binding="{Binding ChannelType}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="带宽"    Width="70"
                                    Binding="{Binding BwLabel}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="频率(MHz)" Width="80"
                                    Binding="{Binding FreqStr}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="调制方式" Width="80"
                                    Binding="{Binding Modulation}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="RB"      Width="50"
                                    Binding="{Binding RbSize}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="Offset"  Width="60"
                                    Binding="{Binding RbOffset}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="实测(dBm)" Width="90"
                                    Binding="{Binding MeasuredPowerStr}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTextColumn Header="Limit"   Width="70"
                                    Binding="{Binding LimitStr}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                <DataGridTemplateColumn Header="状态" Width="70" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontFamily="Segoe UI Semibold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Padding="6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Message" Width="*"
                                    Binding="{Binding Note}" IsReadOnly="True"
                                    ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Cursor="SizeNS"
                              Background="#2A2A2A" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- Log Panel -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1A1A2E" Padding="10,4"
                                CornerRadius="4,4,0,0">
                            <TextBlock Text="SCPI 日志 LOG" FontFamily="Segoe UI Semibold"
                                       FontSize="10" Foreground="#AAAAAA"/>
                        </Border>
                        <TextBox x:Name="TxbLog" Grid.Row="1"
                                 IsReadOnly="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource BgCard}"
                                 Foreground="{StaticResource FgPrim}"
                                 FontFamily="Consolas" FontSize="11"
                                 BorderThickness="0" Padding="6"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════  STATUS BAR  ══════════════════════ -->
        <Border Grid.Row="2" Background="#11111B" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Border}">
            <Grid Margin="10,0">
                <TextBlock x:Name="TxbStatus" Text="Ready."
                           Foreground="{StaticResource FgSec}"
                           FontFamily="Segoe UI" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxbClock" HorizontalAlignment="Right"
                           Foreground="{StaticResource FgSec}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
